# The public HTTPS address used by the mobile application.
VITE_POCKETBASE_URL=https://api.derouaservices.ma

# Domain whose DNS A/AAAA record points to the production server.
PB_DOMAIN=api.derouaservices.ma

# Configure only after deploying/testing the Firebase-authenticated image service.
# No Firebase Storage or billing account is needed for this service.
VITE_IMAGE_SERVICE_URL=
